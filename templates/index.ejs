<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>Check libraries</title>
  </head>
  <body>
    <div class="main">
      <table style="width:100%">
        <tr style="text-align:center, border: 1px solid black">
          <th>Module</th>
          <th>Version</th>
          <th>Submodule</th>
          <th>Check?</th>
        </tr>
        <% for(let i=0; i < modules.length; i++) { %>
           <% for (let j = 0; j < modules[i].submodules.length; j++) { %>
             <tr style="text-align:center">
               <td><label><%= modules[i].name %></label></td>
               <td><label><%= modules[i].version %></label></td>
               <td><label><%= modules[i].submodules[j] %></label></td>
               <td><input type="checkbox" name="modules" checked/></td>
             </tr>
          <% } %>
        <% } %>
