<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>Check libraries</title>
  </head>
  <body>
    <div class="main">
      <form method="post" action="/download">
      <table style="width:100%">
          <tr style="text-align:center, border: 1px solid black">
            <th>Module</th>
            <th>Version</th>
            <th>Submodule</th>
            <th>Check?</th>
            <th>Status</th>
          </tr>
          <% for(let i=0; i < modules.length; i++) { %>
             <% for (let j = 0; j < modules[i].submodules.length; j++) { %>
               <tr style="text-align:center">
                 <td><label><input type="hidden" name="modules_module" value="<%= modules[i].name %>"><%= modules[i].name %></label></td>
                 <td><label><input type="hidden" name="modules_version" value="<%= modules[i].version %>"/><%= modules[i].version %></label></td>
                 <td><label><input type="hidden" name="modules_submodule" value="<%= modules[i].submodules[j] %>"/><%= modules[i].submodules[j] %></label></td>
                 <td><input type="checkbox" name="modules_check" checked/></td>
                 <td><label><input type="hidden" name="modules_status" value="OK"/>OK</label><td>
               </tr>
            <% } %>
          <% } %>
          <tr style="text-align:center">
            <td><label><input type="hidden" name="JSOUP_module" value="JSOUP-module"/>JSOUP MODULE</label></td>
            <td><label><input type="hidden" name="JSOUP_version" value="jsoup_version_2.2.1-rc003"/>2.2.1-rc003</td>
            <td><label><input type="hidden" name="jsoup_submodule" value="jsoup_submodule"/>jsoup submodule</label></td>
            <td><input type="checkbox" id="jsoup_submodule_id" name="jsoup_check" checked/></td>
          </tr>
          <tr style="text-align:center">
            <td><label for="all">All</label></td>
            <td></td>
            <td></td>
            <td><input type="checkbox" id="all" value="ALL" onclick="checkAllModules()" checked></td>
          </tr>
      </table>
      <input style="margin-left:auto; margin-right:auto" type="submit" value="Check">
    </form>
    </div>
  </body>
  <script>
      function checkAllModules() {
          var allCheckBoxChecked = document.getElementById("all").checked;
          var modulesItems = document.getElementsByName("modules_check");
          for (var i = 0; i < modulesItems.length; i++) {
            modulesItems.item(i).checked = allCheckBoxChecked;
          }
      }
  </script>
</html>
