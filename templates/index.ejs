  <script>
      function checkAllModules() {
          var allCheckBoxChecked = document.getElementById("all").checked;
          var modulesItems = document.getElementsByName("modules");
          for (var i = 0; i < modulesItems.length; i++) {
            modulesItems.item(i).checked = allCheckBoxChecked;
          }
      }
  </script>
